generator client {
  provider = "prisma-client"
  output   = "../src/database/generated"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  DRAFT
  PENDING
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum UsagePricingModel {
  FLAT
  TIERED
  VOLUME
  STAIR_STEP
  PACKAGE
}

enum UsageAggregationGrain {
  HOURLY
  DAILY
  BILLING_PERIOD
}

model Tenant {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @db.VarChar(160)
  slug            String           @unique @db.VarChar(80)
  status          TenantStatus     @default(ACTIVE)
  timezone        String           @default("Asia/Kolkata") @db.VarChar(64)
  currency        String           @default("INR") @db.Char(3)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships     Membership[]
  apiKeys         TenantApiKey[]
  customers       Customer[]
  subscriptions   Subscription[]
  usageMeters     UsageMeter[]
  usageEvents     UsageEvent[]
  usageAggregates UsageAggregate[]

  @@map("tenants")
}

model User {
  id              String       @id @default(uuid()) @db.Uuid
  email           String       @unique @db.VarChar(320)
  passwordHash    String       @map("password_hash") @db.VarChar(255)
  displayName     String       @map("display_name") @db.VarChar(160)
  emailVerifiedAt DateTime?    @map("email_verified_at") @db.Timestamptz(3)
  isPlatformAdmin Boolean      @default(false) @map("is_platform_admin")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships     Membership[]

  @@map("users")
}

model TenantApiKey {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String    @db.VarChar(120)
  keyHash   String    @unique @map("key_hash") @db.Char(64)
  scopes    String[]  @default([])
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, revokedAt])
  @@map("tenant_api_keys")
}

model Customer {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  name          String         @db.VarChar(160)
  email         String?        @db.VarChar(320)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  subscriptions Subscription[]
  usageEvents   UsageEvent[]

  @@unique([tenantId, id])
  @@index([tenantId, email])
  @@map("customers")
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  customerId         String             @map("customer_id") @db.Uuid
  status             SubscriptionStatus @default(DRAFT)
  billingPeriodStart DateTime?          @map("billing_period_start") @db.Timestamptz(3)
  billingPeriodEnd   DateTime?          @map("billing_period_end") @db.Timestamptz(3)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer           Customer           @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  usageEvents        UsageEvent[]
  usageAggregates    UsageAggregate[]

  @@unique([tenantId, id])
  @@index([tenantId, customerId, status])
  @@map("subscriptions")
}

model UsageMeter {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  code           String            @db.VarChar(100)
  name           String            @db.VarChar(160)
  unit           String            @db.VarChar(64)
  pricingModel   UsagePricingModel @map("pricing_model")
  unitPriceMinor BigInt            @default(0) @map("unit_price_minor")
  currency       String            @default("INR") @db.Char(3)
  tiers          Json?
  active         Boolean           @default(true)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  events         UsageEvent[]
  aggregates     UsageAggregate[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("usage_meters")
}

model UsageEvent {
  id             String       @id @default(uuid()) @db.Uuid
  eventId        String       @unique @map("event_id") @db.VarChar(255)
  tenantId       String       @map("tenant_id") @db.Uuid
  customerId     String       @map("customer_id") @db.Uuid
  subscriptionId String       @map("subscription_id") @db.Uuid
  meterId        String       @map("meter_id") @db.Uuid
  idempotencyKey String       @map("idempotency_key") @db.VarChar(255)
  quantity       Decimal      @db.Decimal(24, 8)
  occurredAt     DateTime     @map("occurred_at") @db.Timestamptz(3)
  source         String       @db.VarChar(120)
  metadata       Json?
  receivedAt     DateTime     @default(now()) @map("received_at") @db.Timestamptz(3)
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer       Customer     @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  subscription   Subscription @relation(fields: [tenantId, subscriptionId], references: [tenantId, id], onDelete: Restrict)
  meter          UsageMeter   @relation(fields: [tenantId, meterId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, meterId, occurredAt])
  @@index([tenantId, subscriptionId, occurredAt])
  @@map("usage_events")
}

model UsageAggregate {
  id             String                @id @default(uuid()) @db.Uuid
  tenantId       String                @map("tenant_id") @db.Uuid
  meterId        String                @map("meter_id") @db.Uuid
  subscriptionId String                @map("subscription_id") @db.Uuid
  grain          UsageAggregationGrain
  periodStart    DateTime              @map("period_start") @db.Timestamptz(3)
  periodEnd      DateTime              @map("period_end") @db.Timestamptz(3)
  quantity       Decimal               @db.Decimal(28, 8)
  eventCount     BigInt                @map("event_count")
  computedAt     DateTime              @default(now()) @map("computed_at") @db.Timestamptz(3)
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  meter          UsageMeter            @relation(fields: [tenantId, meterId], references: [tenantId, id], onDelete: Restrict)
  subscription   Subscription          @relation(fields: [tenantId, subscriptionId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, meterId, subscriptionId, grain, periodStart])
  @@index([tenantId, subscriptionId, periodStart])
  @@map("usage_aggregates")
}

model Membership {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  status    MembershipStatus @default(INVITED)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles     MembershipRole[]

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([userId, status])
  @@map("memberships")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String?          @map("tenant_id") @db.Uuid
  key         String           @db.VarChar(80)
  name        String           @db.VarChar(120)
  description String?          @db.VarChar(500)
  assignments MembershipRole[]
  permissions RolePermission[]

  @@unique([tenantId, key])
  @@map("roles")
}

model Permission {
  key         String           @id @db.VarChar(120)
  description String?          @db.VarChar(500)
  assignments RolePermission[]

  @@map("permissions")
}

model MembershipRole {
  tenantId     String     @map("tenant_id") @db.Uuid
  membershipId String     @map("membership_id") @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  membership   Membership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([tenantId, membershipId, roleId])
  @@map("membership_roles")
}

model RolePermission {
  roleId        String     @map("role_id") @db.Uuid
  permissionKey String     @map("permission_key") @db.VarChar(120)
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Restrict)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}
